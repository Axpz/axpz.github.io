<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: java; gutter: false; theme: RDark; collapse: true" data-theme=3D"RDark">k=  
ind: PersistentVolumeClaim  
apiVersion: v1  
metadata:
  name: pvc01  
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: default
  resources:
    requests:
      storage: 2Gi
---  
apiVersion: v1  
kind: Pod  
metadata:
  creationTimestamp: null
  labels:
    run: busybox
  name: busybox  
spec:
  volumes:
    - name: vol01
      persistentVolumeClaim:
        claimName: pvc01
  containers:
  - args:
    - sleep
    - "3600"
    image: quay.io/prometheus/busybox:latest
    name: busybox
    resources: {}
    volumeMounts:
    - mountPath: "/data"
      name: vol01
  dnsPolicy: ClusterFirst
  restartPolicy: Never

#kubectl exec busybox -c busybox -- /bin/sh -c "wget www.google.com -O /dat=  
a/www.google.com.html"</pre>=20
