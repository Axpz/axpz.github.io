s/imageTag
        valueFrom:
          template: '{{(index .TKR_DATA .builtin.controlPlane.version).kube=  
rnetesSpec.coredns.imageTag}}'
      selector:
        apiVersion: controlplane.cluster.x-k8s.io/v1beta1
        kind: KubeadmControlPlaneTemplate
        matchResources:
          controlPlane: true
    name: kubeadmControlPlaneTemplate
  - definitions:
    - jsonPatches:
      - op: replace
        path: /spec/template/spec/users
        valueFrom:
          template: |
            - name: capv
              sshAuthorizedKeys:
              {{- range .user.sshAuthorizedKeys }}
              - ' {{- . -}} '
              {{- end }}
              sudo: ALL=3D(ALL) NOPASSWD:ALL
      selector:
        apiVersion: bootstrap.cluster.x-k8s.io/v1beta1
