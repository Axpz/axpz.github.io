egistration/kubeletExtraArgs/node-ip
        value: '::'
      - op: add
        path: /spec/template/spec/kubeadmConfigSpec/clusterConfiguration/ap=  
iServer/extraArgs/advertise-address
        valueFrom:
          variable: apiServerEndpoint
      - op: add
        path: /spec/template/spec/kubeadmConfigSpec/clusterConfiguration/ap=  
iServer/extraArgs/bind-address
        value: '::'
