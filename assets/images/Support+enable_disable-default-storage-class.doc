<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: java; gutter: false; theme: RDark; collapse: true" data-theme=3D"RDark">a=  
piVersion: run.tanzu.vmware.com/v1alpha3  
kind: ClusterBootstrap  
metadata:
&nbsp; annotations:
&nbsp; &nbsp; tkg.tanzu.vmware.com/add-missing-fields-from-tkr: v1.26.5---v=  
