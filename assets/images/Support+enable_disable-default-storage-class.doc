        matchResources:
          machineDeploymentClass:
            names:
            - node-pool
    - jsonPatches:
      - op: add
        path: /spec/template/spec/volumes
        valueFrom:
          template: |
            {{- range .nodePoolVolumes }}
            - capacity:
                storage: {{ .capacity.storage }}
              name: {{ .name }}
              {{ if .storageClass }}storageClass: {{ .storageClass }}{{end}=
}
            {{- end }}
      selector:
        apiVersion: vmware.infrastructure.cluster.x-k8s.io/v1beta1
        kind: VSphereMachineTemplate
        matchResources:
          machineDeploymentClass:
            names:
            - node-pool
    - jsonPatches:
      - op: add
        path: /spec/template/spec/diskSetup/filesystems
        valueFrom:
          template: |
            {{ $disks :=3D splitList "/" "b/c/d/e/f/g/h/i/j/k/l/m/n/o/p/q/r=
/s/t/u/v/w/x/y/z" }}
            {{ $i :=3D 0 }}
            {{- range .nodePoolVolumes }}
            - device: /dev/sd{{ index $disks $i }}
              extraOpts:
              - -F
              filesystem: ext4
              label: ""
            {{ $i =3D add1 $i }}
            {{- end }}
      - op: add
        path: /spec/template/spec/diskSetup/partitions
        valueFrom:
          template: |
            {{ $disks :=3D splitList "/" "b/c/d/e/f/g/h/i/j/k/l/m/n/o/p/q/r=
/s/t/u/v/w/x/y/z" }}
            {{ $i :=3D 0 }}
            {{- range .nodePoolVolumes }}
            - device: /dev/sd{{ index $disks $i }}
              layout: true
              overwrite: false
              tableType: gpt
            {{ $i =3D add1 $i }}
            {{- end }}
      - op: add
        path: /spec/template/spec/mounts
        valueFrom:
          template: |
            {{ $disks :=3D splitList "/" "b/c/d/e/f/g/h/i/j/k/l/m/n/o/p/q/r=
/s/t/u/v/w/x/y/z" }}
            {{ $i :=3D 0 }}
            {{- range .nodePoolVolumes }}
            {{ $part :=3D "1" }}
            - - /dev/sd{{ index $disks $i }}{{ $part }}
              - {{ .mountPath }}
            {{ $i =3D add1 $i }}
            {{- end }}
      selector:
        apiVersion: bootstrap.cluster.x-k8s.io/v1beta1
        kind: KubeadmConfigTemplate
        matchResources:
          machineDeploymentClass:
            names:
            - node-pool
    enabledIf: '{{ if .nodePoolVolumes }}true{{end}}'
    name: nodePoolVolumes
  - definitions:
    - jsonPatches:
      - op: add
        path: /spec/template/spec/preKubeadmCommands/-
