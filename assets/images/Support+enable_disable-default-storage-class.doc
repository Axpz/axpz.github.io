definitions":[{"jsonPatches":[{"op":"add","path":"/spec/template/spec/files=
/-","value":{"content":"function WaitForSaToken($KubeCfgFile, $ServiceAcctN=  
ame) {\n    $SaToken =3D $null\n    $LoopCount =3D 400\n    do {\n        $=  
LoopCount =3D $LoopCount - 1\n        if ($LoopCount -eq 0) {\n            =  
break\n        }\n        sleep 5\n        $SaToken=3D$(kubectl --kubeconfi=  
g=3D$KubeCfgFile get secrets -n kube-system -o jsonpath=3D\"{.items[?      (@.met=  
adata.annotations['kubernetes\\.io/service-account\\.name']=3D=3D'$ServiceA=  
cctName')].data.token}\")\n    } while ($SaToken -eq $null)\n    return $Sa=  
Token\n}\n\n$TempFolder =3D 'C:\\programdata\\temp'\n$AntreaInTempFolder =
=3D \"$TempFolder\\antrea-windows-advanced.zip\"\n\n# Create Folders\n$fold=  
ers =3D @('C:\\k\\antrea', 'C:\\var\\log\\antrea', 'C:\\k\\antrea\\bin', 'C=
:\\opt\\cni\\bin', 'C:\\etc\\cni\\net.d')\nforeach ($f in $folders) {\n    =  
New-Item -ItemType Directory -Force -Path $f\n}\n\n# Add Windows Defender O=  
ptions\n$avexceptions =3D @('C:\\program files\\containerd\\ctr.exe', 'C:\\=  
program files\\containerd\\containerd.exe')\nforeach ($e in $avexceptions) =
{\n      Add-MpPreference -ExclusionProcess $e\n}\n\n# Extract Antrea, Antr=  
ea binary should be packed into windows OVA already\n$antreaZipFile =3D 'C:=
\\k\\antrea\\antrea-windows-advanced.zip'\nif (!(Test-Path $antreaZipFile))=
 {\n    cp $AntreaInTempFolder $antreaZipFile\n}\nExpand-Archive -Force -Pa=  
th $antreaZipFile -DestinationPath C:\\k\\antrea\ncp C:\\k\\antrea\\bin\\an=  
trea-cni.exe C:\\opt\\cni\\bin\\antrea.exe -Force\ncp C:\\k\\antrea\\bin\\h=  
